# Supabase project URL (Settings > API)
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Browser key: the publishable (or legacy anon) key. Never the secret/service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only secret key, used by the API routes
SUPABASE_KEY=sb_secret_...

# Comma-separated emails allowed to upload, edit and delete photos
ADMIN_EMAILS=you@example.com
